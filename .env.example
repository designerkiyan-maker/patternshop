# توکن بات از @BotFather
BOT_TOKEN=1234567890:AAF...your-token-here

# آیدی عددی تلگرام مالک (از @userinfobot یا @RawDataBot بگیر)
OWNER_ID=123456789

# (اختیاری) آدرس HTTPS مینی‌اپ فروشگاه - مثلاً https://shop.example.com
# خالی یعنی دکمه‌ی «فروشگاه وب» در منو نمایش داده نمی‌شود
MINIAPP_URL=

# (اختیاری) کلید امضای نشست پنل مدیریت وب مستقل - هر رشته‌ی تصادفی طولانی
# اگر خالی باشد با هر ری‌استارت همه‌ی لاگین‌های پنل وب خالی می‌شود
ADMIN_PANEL_SECRET=

# (اختیاری) کلیدهای VAPID برای اعلان Push مرورگر پنل مدیریت وب
# ساخت: python -m admin_panel.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com
